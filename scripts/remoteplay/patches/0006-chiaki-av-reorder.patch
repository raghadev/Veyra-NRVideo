diff --git a/lib/include/chiaki/avreorder.h b/lib/include/chiaki/avreorder.h
new file mode 100644
index 0000000..f7e389e
--- /dev/null
+++ b/lib/include/chiaki/avreorder.h
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+/**
+ * Wait policy for the takion video reorder queue.
+ *
+ * The queue delivers video packets in order. When the packet at its head is missing, the old policy held
+ * every later packet for a fixed 16 ms, even when the frame of the missing packet could already be
+ * rebuilt by FEC. This policy:
+ *  - skips a missing packet immediately when its frame already has enough units (delivered + queued)
+ *    for FEC to rebuild it, so nothing is lost by not waiting;
+ *  - otherwise waits for an adaptive window (2..16 ms) learnt from how late reordered packets really
+ *    arrive on this link, rising at once when a packet shows up after its gap was skipped.
+ *
+ * It is separate from takion so the decision can be tested without sockets or threads.
+ */
+
+#ifndef CHIAKI_AVREORDER_H
+#define CHIAKI_AVREORDER_H
+
+#include "common.h"
+#include "thread.h"
+#include "seqnum.h"
+#include "reorderqueue.h"
+#include "packetstats.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CHIAKI_AV_REORDER_WINDOW_MIN_US 2000
+#define CHIAKI_AV_REORDER_WINDOW_MAX_US 16000
+#define CHIAKI_AV_REORDER_PEAK_HALF_LIFE_US 1500000
+#define CHIAKI_AV_REORDER_WINDOW_FALL_US_PER_S 2000
+#define CHIAKI_AV_REORDER_SKIP_HISTORY 16
+
+// 1 = adaptive policy (default), 0 = the old fixed 16 ms wait without FEC skipping.
+#ifndef CHIAKI_AV_REORDER_ADAPTIVE_DEFAULT
+#define CHIAKI_AV_REORDER_ADAPTIVE_DEFAULT 1
+#endif
+
+/**
+ * The fields of a queued video packet that the policy reads.
+ */
+typedef struct chiaki_av_reorder_unit_t
+{
+	ChiakiSeqNum16 packet_index;
+	ChiakiSeqNum16 frame_index;
+	uint16_t unit_index;
+	uint16_t units_total; // source + fec
+	uint16_t units_fec;
+} ChiakiAvReorderUnit;
+
+/**
+ * Fill out with the fields of the queued entry. Return false if the entry has no usable fields.
+ */
+typedef bool (*ChiakiAvReorderUnitOf)(void *entry, ChiakiAvReorderUnit *out);
+
+/**
+ * Receives each entry in order and takes ownership of it.
+ */
+typedef void (*ChiakiAvReorderDispatch)(uint64_t seq_num, void *entry, void *user);
+
+typedef struct chiaki_av_reorder_stats_t
+{
+	uint64_t gaps; // missing head packets noticed
+	uint64_t fec_skips; // gaps skipped at once because FEC can rebuild the frame
+	uint64_t timeout_skips; // gaps skipped after the wait window expired
+	uint64_t late_fills; // missing packets that arrived inside the window
+	uint64_t too_late_timeout; // packets that arrived after their gap was skipped on timeout
+	uint64_t too_late_fec; // packets that arrived after their gap was skipped through FEC (no cost)
+	uint64_t wait_us_total; // time the head of the queue spent waiting
+	uint32_t wait_us_max; // longest single wait
+	uint32_t window_us; // wait window in force
+	bool adaptive;
+} ChiakiAvReorderStats;
+
+/**
+ * Published copy of the statistics. Written by the takion thread, read from any thread.
+ */
+typedef struct chiaki_av_reorder_stats_box_t
+{
+	ChiakiMutex mutex;
+	ChiakiAvReorderStats stats;
+	// Set once before the takion thread starts, may be NULL: where a reordered packet that arrived after
+	// its gap was skipped through FEC is credited back as received (the loss report goes to the console).
+	ChiakiPacketStats *packet_stats;
+} ChiakiAvReorderStatsBox;
+
+typedef enum chiaki_av_reorder_skip_reason_t
+{
+	CHIAKI_AV_REORDER_SKIP_NONE = 0,
+	CHIAKI_AV_REORDER_SKIP_FEC = 1,
+	CHIAKI_AV_REORDER_SKIP_TIMEOUT = 2
+} ChiakiAvReorderSkipReason;
+
+typedef struct chiaki_av_reorder_skip_t
+{
+	uint64_t first;
+	uint64_t count;
+	int64_t gap_start_us;
+	ChiakiAvReorderSkipReason reason;
+} ChiakiAvReorderSkip;
+
+typedef struct chiaki_av_reorder_t
+{
+	bool adaptive;
+
+	bool head_waiting; // the head of the queue is missing since head_wait_start_us
+	int64_t head_wait_start_us;
+	uint64_t head_wait_seq_num;
+
+	bool have_dispatch; // the last delivered frame, to count its units
+	ChiakiSeqNum16 dispatch_frame_index;
+	ChiakiSeqNum16 dispatch_frame_first;
+	uint16_t dispatch_frame_total;
+	uint16_t dispatch_frame_fec;
+	uint16_t dispatch_frame_units;
+
+	bool clock_started;
+	uint32_t window_us;
+	uint32_t peak_us; // peak of observed reorder delay, as of peak_at_us
+	int64_t peak_at_us;
+	int64_t last_decay_us;
+
+	ChiakiAvReorderSkip skipped[CHIAKI_AV_REORDER_SKIP_HISTORY];
+	size_t skipped_next;
+
+	ChiakiAvReorderStats stats;
+	bool stats_dirty;
+	ChiakiAvReorderStatsBox *box; // may be NULL
+} ChiakiAvReorder;
+
+CHIAKI_EXPORT void chiaki_av_reorder_init(ChiakiAvReorder *reorder, bool adaptive, ChiakiAvReorderStatsBox *box);
+
+/**
+ * Call for every video packet BEFORE chiaki_reorder_queue_push(). Only observes: a packet that fills the
+ * missing head inside the window teaches the window, a packet older than the head of the queue is
+ * classified as too late.
+ */
+CHIAKI_EXPORT void chiaki_av_reorder_on_arrival(ChiakiAvReorder *reorder, ChiakiReorderQueue *queue, uint64_t seq_num, int64_t now_us);
+
+/**
+ * Deliver everything that can be delivered now, skipping gaps per the policy.
+ * Every delivered entry goes through dispatch, which takes ownership.
+ */
+CHIAKI_EXPORT void chiaki_av_reorder_flush(ChiakiAvReorder *reorder, ChiakiReorderQueue *queue, int64_t now_us,
+		ChiakiAvReorderUnitOf unit_of, ChiakiAvReorderDispatch dispatch, void *user);
+
+/**
+ * Microseconds until flush must run again for a pending gap, or -1 if no gap is pending.
+ */
+CHIAKI_EXPORT int64_t chiaki_av_reorder_next_timeout_us(ChiakiAvReorder *reorder, int64_t now_us);
+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_av_reorder_stats_box_init(ChiakiAvReorderStatsBox *box);
+CHIAKI_EXPORT void chiaki_av_reorder_stats_box_fini(ChiakiAvReorderStatsBox *box);
+CHIAKI_EXPORT void chiaki_av_reorder_stats_get(ChiakiAvReorderStatsBox *box, ChiakiAvReorderStats *out);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // CHIAKI_AVREORDER_H
