diff --git a/lib/src/avreorder.c b/lib/src/avreorder.c
new file mode 100644
index 0000000..347d2f4
--- /dev/null
+++ b/lib/src/avreorder.c
@@ -0,0 +1,402 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include <chiaki/avreorder.h>
+
+#include <string.h>
+
+static uint32_t clamp_window(uint64_t v)
+{
+	if(v < CHIAKI_AV_REORDER_WINDOW_MIN_US)
+		return CHIAKI_AV_REORDER_WINDOW_MIN_US;
+	if(v > CHIAKI_AV_REORDER_WINDOW_MAX_US)
+		return CHIAKI_AV_REORDER_WINDOW_MAX_US;
+	return (uint32_t)v;
+}
+
+/**
+ * Peak halved for every half-life since it was set, with a linear step for the part of a half-life
+ * that has passed. Computed from the time of the peak, so it does not depend on how often it is called.
+ */
+static uint32_t decayed_peak(const ChiakiAvReorder *reorder, int64_t now_us)
+{
+	if(now_us <= reorder->peak_at_us)
+		return reorder->peak_us;
+	uint64_t elapsed = (uint64_t)(now_us - reorder->peak_at_us);
+	uint64_t halves = elapsed / CHIAKI_AV_REORDER_PEAK_HALF_LIFE_US;
+	if(halves >= 32)
+		return 0;
+	uint64_t v = (uint64_t)reorder->peak_us >> halves;
+	uint64_t frac = elapsed % CHIAKI_AV_REORDER_PEAK_HALF_LIFE_US;
+	v -= (v * frac) / (2 * (uint64_t)CHIAKI_AV_REORDER_PEAK_HALF_LIFE_US);
+	return (uint32_t)v;
+}
+
+static uint32_t target_window(uint32_t peak_us)
+{
+	return clamp_window((uint64_t)peak_us * 3 / 2 + 1000);
+}
+
+static void start_clock(ChiakiAvReorder *reorder, int64_t now_us)
+{
+	if(reorder->clock_started)
+		return;
+	reorder->clock_started = true;
+	reorder->peak_at_us = now_us;
+	reorder->last_decay_us = now_us;
+}
+
+static void set_window(ChiakiAvReorder *reorder, uint32_t window_us)
+{
+	if(window_us == reorder->window_us)
+		return;
+	reorder->window_us = window_us;
+	reorder->stats_dirty = true;
+}
+
+/**
+ * Let the window fall toward the target, at most CHIAKI_AV_REORDER_WINDOW_FALL_US_PER_S.
+ */
+static void decay(ChiakiAvReorder *reorder, int64_t now_us)
+{
+	start_clock(reorder, now_us);
+	if(!reorder->adaptive || now_us <= reorder->last_decay_us)
+		return;
+	uint32_t target = target_window(decayed_peak(reorder, now_us));
+	if(reorder->window_us <= target)
+	{
+		reorder->last_decay_us = now_us;
+		return;
+	}
+	uint64_t elapsed = (uint64_t)(now_us - reorder->last_decay_us);
+	uint64_t fall = elapsed * CHIAKI_AV_REORDER_WINDOW_FALL_US_PER_S / 1000000;
+	if(fall == 0)
+		return; // keep accumulating time instead of losing it to rounding
+	uint64_t window = reorder->window_us > fall ? reorder->window_us - fall : 0;
+	if(window <= target)
+	{
+		window = target;
+		reorder->last_decay_us = now_us;
+	}
+	else
+		reorder->last_decay_us += (int64_t)(fall * 1000000 / CHIAKI_AV_REORDER_WINDOW_FALL_US_PER_S);
+	set_window(reorder, (uint32_t)window);
+}
+
+/**
+ * A packet showed up `late_us` after its gap was noticed: the link reorders at least that much.
+ */
+static void observe_late(ChiakiAvReorder *reorder, int64_t late_us, int64_t now_us)
+{
+	decay(reorder, now_us);
+	if(late_us < 0)
+		late_us = 0;
+	if(late_us > 1000000)
+		late_us = 1000000;
+	uint32_t peak = decayed_peak(reorder, now_us);
+	if((uint32_t)late_us > peak)
+		peak = (uint32_t)late_us;
+	reorder->peak_us = peak;
+	reorder->peak_at_us = now_us;
+	if(reorder->adaptive)
+	{
+		uint32_t target = target_window(peak);
+		if(target > reorder->window_us)
+			set_window(reorder, target);
+	}
+	reorder->stats_dirty = true;
+}
+
+static void account_wait(ChiakiAvReorder *reorder, int64_t now_us)
+{
+	if(!reorder->head_waiting)
+		return;
+	int64_t waited = now_us - reorder->head_wait_start_us;
+	if(waited < 0)
+		waited = 0;
+	reorder->stats.wait_us_total += (uint64_t)waited;
+	uint32_t w = waited > (int64_t)UINT32_MAX ? UINT32_MAX : (uint32_t)waited;
+	if(w > reorder->stats.wait_us_max)
+		reorder->stats.wait_us_max = w;
+	reorder->stats_dirty = true;
+}
+
+static void record_skip(ChiakiAvReorder *reorder, uint64_t first, uint64_t count, ChiakiAvReorderSkipReason reason)
+{
+	ChiakiAvReorderSkip *skip = &reorder->skipped[reorder->skipped_next];
+	skip->first = first;
+	skip->count = count;
+	skip->gap_start_us = reorder->head_wait_start_us;
+	skip->reason = reason;
+	reorder->skipped_next = (reorder->skipped_next + 1) % CHIAKI_AV_REORDER_SKIP_HISTORY;
+}
+
+static const ChiakiAvReorderSkip *find_skip(const ChiakiAvReorder *reorder, const ChiakiReorderQueue *queue, uint64_t seq_num)
+{
+	for(size_t i=0; i<CHIAKI_AV_REORDER_SKIP_HISTORY; i++)
+	{
+		const ChiakiAvReorderSkip *skip = &reorder->skipped[i];
+		if(skip->reason == CHIAKI_AV_REORDER_SKIP_NONE)
+			continue;
+		uint64_t end = queue->seq_num_add(skip->first, skip->count);
+		if(!queue->seq_num_lt(seq_num, skip->first) && queue->seq_num_lt(seq_num, end))
+			return skip;
+	}
+	return NULL;
+}
+
+static void publish(ChiakiAvReorder *reorder)
+{
+	if(!reorder->stats_dirty)
+		return;
+	reorder->stats_dirty = false;
+	reorder->stats.window_us = reorder->window_us;
+	reorder->stats.adaptive = reorder->adaptive;
+	if(!reorder->box)
+		return;
+	chiaki_mutex_lock(&reorder->box->mutex);
+	reorder->box->stats = reorder->stats;
+	chiaki_mutex_unlock(&reorder->box->mutex);
+}
+
+static void track_dispatch(ChiakiAvReorder *reorder, void *entry, ChiakiAvReorderUnitOf unit_of)
+{
+	ChiakiAvReorderUnit unit;
+	if(!unit_of(entry, &unit))
+		return;
+	ChiakiSeqNum16 first = (ChiakiSeqNum16)(unit.packet_index - unit.unit_index);
+	if(reorder->have_dispatch && unit.frame_index == reorder->dispatch_frame_index && first == reorder->dispatch_frame_first)
+	{
+		if(reorder->dispatch_frame_units < UINT16_MAX)
+			reorder->dispatch_frame_units++;
+		return;
+	}
+	reorder->have_dispatch = true;
+	reorder->dispatch_frame_index = unit.frame_index;
+	reorder->dispatch_frame_first = first;
+	reorder->dispatch_frame_total = unit.units_total;
+	reorder->dispatch_frame_fec = unit.units_fec;
+	reorder->dispatch_frame_units = 1;
+}
+
+// Packet indices are 16 bit and contiguous inside a frame (the takion queue is initialized the same way).
+static bool seq_in_frame(uint64_t seq_num, ChiakiSeqNum16 first, uint16_t total)
+{
+	return total > 0 && (ChiakiSeqNum16)((ChiakiSeqNum16)seq_num - first) < total;
+}
+
+/**
+ * Whether FEC can rebuild the frame of the missing sequence number with the units delivered and queued.
+ * Unknown frame => false (the old wait applies).
+ */
+static bool gap_rebuildable(ChiakiAvReorder *reorder, ChiakiReorderQueue *queue, uint64_t gap, ChiakiAvReorderUnitOf unit_of)
+{
+	bool known = false;
+	ChiakiSeqNum16 frame_index = 0, first = 0;
+	uint16_t total = 0, fec = 0;
+	if(reorder->have_dispatch && seq_in_frame(gap, reorder->dispatch_frame_first, reorder->dispatch_frame_total))
+	{
+		known = true;
+		frame_index = reorder->dispatch_frame_index;
+		first = reorder->dispatch_frame_first;
+		total = reorder->dispatch_frame_total;
+		fec = reorder->dispatch_frame_fec;
+	}
+	uint64_t seq_num;
+	void *entry;
+	ChiakiAvReorderUnit unit;
+	for(uint64_t i=0; !known && i<chiaki_reorder_queue_count(queue); i++)
+	{
+		if(!chiaki_reorder_queue_peek(queue, i, &seq_num, &entry) || !unit_of(entry, &unit))
+			continue;
+		ChiakiSeqNum16 unit_first = (ChiakiSeqNum16)(unit.packet_index - unit.unit_index);
+		if(!seq_in_frame(gap, unit_first, unit.units_total))
+			continue;
+		known = true;
+		frame_index = unit.frame_index;
+		first = unit_first;
+		total = unit.units_total;
+		fec = unit.units_fec;
+	}
+	if(!known || fec >= total)
+		return false;
+
+	uint32_t needed = (uint32_t)total - fec;
+	uint32_t available = 0;
+	if(reorder->have_dispatch && reorder->dispatch_frame_index == frame_index && reorder->dispatch_frame_first == first)
+		available = reorder->dispatch_frame_units;
+	for(uint64_t i=0; i<chiaki_reorder_queue_count(queue) && available < needed; i++)
+	{
+		if(!chiaki_reorder_queue_peek(queue, i, &seq_num, &entry) || !unit_of(entry, &unit))
+			continue;
+		if(unit.frame_index == frame_index && (ChiakiSeqNum16)(unit.packet_index - unit.unit_index) == first)
+			available++;
+	}
+	return available >= needed;
+}
+
+static void skip_head(ChiakiAvReorder *reorder, ChiakiReorderQueue *queue, uint64_t count, ChiakiAvReorderSkipReason reason, int64_t now_us)
+{
+	record_skip(reorder, queue->begin, count, reason);
+	account_wait(reorder, now_us);
+	queue->begin = queue->seq_num_add(queue->begin, count);
+	queue->count -= count;
+	reorder->head_waiting = false;
+	if(reason == CHIAKI_AV_REORDER_SKIP_FEC)
+		reorder->stats.fec_skips++;
+	else
+		reorder->stats.timeout_skips++;
+	reorder->stats_dirty = true;
+}
+
+CHIAKI_EXPORT void chiaki_av_reorder_init(ChiakiAvReorder *reorder, bool adaptive, ChiakiAvReorderStatsBox *box)
+{
+	memset(reorder, 0, sizeof(*reorder));
+	reorder->adaptive = adaptive;
+	reorder->window_us = CHIAKI_AV_REORDER_WINDOW_MAX_US;
+	reorder->peak_us = CHIAKI_AV_REORDER_WINDOW_MAX_US;
+	reorder->box = box;
+	reorder->stats_dirty = true;
+	publish(reorder);
+}
+
+CHIAKI_EXPORT void chiaki_av_reorder_on_arrival(ChiakiAvReorder *reorder, ChiakiReorderQueue *queue, uint64_t seq_num, int64_t now_us)
+{
+	start_clock(reorder, now_us);
+	if(reorder->head_waiting && seq_num == queue->begin)
+	{
+		reorder->stats.late_fills++;
+		observe_late(reorder, now_us - reorder->head_wait_start_us, now_us);
+	}
+	else if(queue->seq_num_lt(seq_num, queue->begin))
+	{
+		const ChiakiAvReorderSkip *skip = find_skip(reorder, queue, seq_num);
+		if(skip && skip->reason == CHIAKI_AV_REORDER_SKIP_TIMEOUT)
+		{
+			reorder->stats.too_late_timeout++;
+			observe_late(reorder, now_us - skip->gap_start_us, now_us);
+		}
+		else if(skip && skip->reason == CHIAKI_AV_REORDER_SKIP_FEC)
+		{
+			reorder->stats.too_late_fec++;
+			reorder->stats_dirty = true;
+			// Only reordered, and the old fixed wait would have delivered it: do not report it as lost.
+			if(now_us - skip->gap_start_us <= CHIAKI_AV_REORDER_WINDOW_MAX_US && reorder->box && reorder->box->packet_stats)
+				chiaki_packet_stats_push_late_unit(reorder->box->packet_stats);
+		}
+	}
+	publish(reorder);
+}
+
+CHIAKI_EXPORT void chiaki_av_reorder_flush(ChiakiAvReorder *reorder, ChiakiReorderQueue *queue, int64_t now_us,
+		ChiakiAvReorderUnitOf unit_of, ChiakiAvReorderDispatch dispatch, void *user)
+{
+	decay(reorder, now_us);
+	bool progress = true;
+	while(progress)
+	{
+		progress = false;
+
+		uint64_t seq_num;
+		void *entry;
+		while(chiaki_reorder_queue_pull(queue, &seq_num, &entry))
+		{
+			progress = true;
+			track_dispatch(reorder, entry, unit_of);
+			dispatch(seq_num, entry, user);
+		}
+		if(progress && reorder->head_waiting)
+		{
+			// the missing head arrived (or the queue moved past it)
+			account_wait(reorder, now_us);
+			reorder->head_waiting = false;
+		}
+
+		if(chiaki_reorder_queue_count(queue) == 0)
+			break;
+
+		// The head slot is missing (lost or not arrived yet).
+		if(!reorder->head_waiting)
+		{
+			reorder->head_waiting = true;
+			reorder->head_wait_start_us = now_us;
+			reorder->head_wait_seq_num = queue->begin;
+			reorder->stats.gaps++;
+			reorder->stats_dirty = true;
+		}
+		else if(queue->begin != reorder->head_wait_seq_num)
+		{
+			if(queue->seq_num_gt(queue->begin, reorder->head_wait_seq_num))
+			{
+				// The missing head advanced within the same loss burst (queue overflow):
+				// keep the original wait budget but track the new missing sequence number.
+				reorder->head_wait_seq_num = queue->begin;
+			}
+			else
+			{
+				account_wait(reorder, now_us);
+				reorder->head_wait_start_us = now_us;
+				reorder->head_wait_seq_num = queue->begin;
+				reorder->stats.gaps++;
+				reorder->stats_dirty = true;
+				break;
+			}
+		}
+
+		if(reorder->adaptive)
+		{
+			// Skip every missing packet at the head whose frame FEC can already rebuild.
+			uint64_t run = 0;
+			while(run < chiaki_reorder_queue_count(queue)
+					&& !chiaki_reorder_queue_peek(queue, run, &seq_num, &entry)
+					&& gap_rebuildable(reorder, queue, queue->seq_num_add(queue->begin, run), unit_of))
+				run++;
+			if(run > 0 && run < chiaki_reorder_queue_count(queue))
+			{
+				skip_head(reorder, queue, run, CHIAKI_AV_REORDER_SKIP_FEC, now_us);
+				progress = true;
+				continue;
+			}
+		}
+
+		if(now_us - reorder->head_wait_start_us <= (int64_t)reorder->window_us)
+			break;
+
+		// Window expired: skip directly to the first buffered packet so a burst only pays one wait.
+		uint64_t skipped = 0;
+		while(skipped < chiaki_reorder_queue_count(queue) && !chiaki_reorder_queue_peek(queue, skipped, &seq_num, &entry))
+			skipped++;
+		if(skipped == 0 || skipped >= chiaki_reorder_queue_count(queue))
+			break;
+		skip_head(reorder, queue, skipped, CHIAKI_AV_REORDER_SKIP_TIMEOUT, now_us);
+		progress = true;
+	}
+	publish(reorder);
+}
+
+CHIAKI_EXPORT int64_t chiaki_av_reorder_next_timeout_us(ChiakiAvReorder *reorder, int64_t now_us)
+{
+	if(!reorder->head_waiting)
+		return -1;
+	int64_t remaining = reorder->head_wait_start_us + (int64_t)reorder->window_us - now_us;
+	return remaining > 0 ? remaining : 0;
+}
+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_av_reorder_stats_box_init(ChiakiAvReorderStatsBox *box)
+{
+	memset(&box->stats, 0, sizeof(box->stats));
+	box->stats.window_us = CHIAKI_AV_REORDER_WINDOW_MAX_US;
+	box->packet_stats = NULL;
+	return chiaki_mutex_init(&box->mutex, false);
+}
+
+CHIAKI_EXPORT void chiaki_av_reorder_stats_box_fini(ChiakiAvReorderStatsBox *box)
+{
+	chiaki_mutex_fini(&box->mutex);
+}
+
+CHIAKI_EXPORT void chiaki_av_reorder_stats_get(ChiakiAvReorderStatsBox *box, ChiakiAvReorderStats *out)
+{
+	chiaki_mutex_lock(&box->mutex);
+	*out = box->stats;
+	chiaki_mutex_unlock(&box->mutex);
+}
