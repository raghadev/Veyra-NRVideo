@@ -0,0 +1,716 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include <munit.h>
+
+#include <chiaki/avreorder.h>
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct fake_entry_t
+{
+	ChiakiAvReorderUnit unit;
+	uint64_t id;
+} FakeEntry;
+
+#define LOG_MAX 256
+
+typedef struct harness_t
+{
+	ChiakiReorderQueue queue;
+	ChiakiAvReorder reorder;
+	FakeEntry entries[LOG_MAX];
+	size_t entries_count;
+	uint64_t dispatched_seq[LOG_MAX];
+	int64_t dispatched_at[LOG_MAX];
+	size_t dispatched_count;
+	size_t dropped_count;
+	int64_t now;
+} Harness;
+
+static bool unit_of(void *entry, ChiakiAvReorderUnit *out)
+{
+	*out = ((FakeEntry *)entry)->unit;
+	return true;
+}
+
+static void dispatch(uint64_t seq_num, void *entry, void *user)
+{
+	(void)entry;
+	Harness *h = user;
+	if(h->dispatched_count < LOG_MAX)
+	{
+		h->dispatched_seq[h->dispatched_count] = seq_num;
+		h->dispatched_at[h->dispatched_count] = h->now;
+		h->dispatched_count++;
+	}
+}
+
+static void drop(uint64_t seq_num, void *elem_user, void *cb_user)
+{
+	(void)seq_num;
+	(void)elem_user;
+	((Harness *)cb_user)->dropped_count++;
+}
+
+static void harness_init(Harness *h, bool adaptive, ChiakiSeqNum16 first_seq)
+{
+	memset(h, 0, sizeof(*h));
+	munit_assert_int(chiaki_reorder_queue_init_16(&h->queue, 6, first_seq), ==, CHIAKI_ERR_SUCCESS);
+	chiaki_reorder_queue_set_drop_strategy(&h->queue, CHIAKI_REORDER_QUEUE_DROP_STRATEGY_BEGIN);
+	chiaki_reorder_queue_set_drop_cb(&h->queue, drop, h);
+	chiaki_av_reorder_init(&h->reorder, adaptive, NULL);
+}
+
+static void harness_fini(Harness *h)
+{
+	chiaki_reorder_queue_fini(&h->queue);
+}
+
+static void flush_at(Harness *h, int64_t now)
+{
+	h->now = now;
+	chiaki_av_reorder_flush(&h->reorder, &h->queue, now, unit_of, dispatch, h);
+}
+
+/**
+ * Packet `unit_index` of the frame `frame_index` whose first packet has sequence number `first`.
+ */
+static void arrive(Harness *h, int64_t now, ChiakiSeqNum16 frame_index, ChiakiSeqNum16 first, uint16_t unit_index,
+		uint16_t total, uint16_t fec)
+{
+	munit_assert_size(h->entries_count, <, LOG_MAX);
+	FakeEntry *e = &h->entries[h->entries_count++];
+	e->unit.frame_index = frame_index;
+	e->unit.packet_index = (ChiakiSeqNum16)(first + unit_index);
+	e->unit.unit_index = unit_index;
+	e->unit.units_total = total;
+	e->unit.units_fec = fec;
+	h->now = now;
+	chiaki_av_reorder_on_arrival(&h->reorder, &h->queue, e->unit.packet_index, now);
+	chiaki_reorder_queue_push(&h->queue, e->unit.packet_index, e);
+	flush_at(h, now);
+}
+
+static bool was_dispatched(Harness *h, uint64_t seq, int64_t *at)
+{
+	for(size_t i=0; i<h->dispatched_count; i++)
+	{
+		if(h->dispatched_seq[i] == seq)
+		{
+			if(at)
+				*at = h->dispatched_at[i];
+			return true;
+		}
+	}
+	return false;
+}
+
+// A source unit is missing, the rest of the frame (with FEC) arrives: no wait at all.
+static MunitResult test_fec_skip_now(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	Harness h;
+	harness_init(&h, true, 100);
+	// frame 7: 6 units, 2 of them FEC => 4 needed. Unit 2 (seq 102) is lost.
+	arrive(&h, 0, 7, 100, 0, 6, 2);
+	arrive(&h, 100, 7, 100, 1, 6, 2);
+	arrive(&h, 1000, 7, 100, 3, 6, 2); // 2 delivered + 1 queued = 3 < 4: must wait
+	munit_assert(!was_dispatched(&h, 103, NULL));
+	arrive(&h, 1100, 7, 100, 4, 6, 2); // 2 + 2 = 4: rebuildable, skip at once
+	int64_t at = -1;
+	munit_assert(was_dispatched(&h, 103, &at));
+	munit_assert_int64(at, ==, 1100);
+	munit_assert(was_dispatched(&h, 104, &at));
+	munit_assert_int64(at, ==, 1100);
+	munit_assert_uint64(h.reorder.stats.gaps, ==, 1);
+	munit_assert_uint64(h.reorder.stats.fec_skips, ==, 1);
+	munit_assert_uint64(h.reorder.stats.timeout_skips, ==, 0);
+	munit_assert_uint64(h.reorder.stats.wait_us_total, ==, 100); // noticed at 1000, skipped at 1100
+	harness_fini(&h);
+	return MUNIT_OK;
+}
