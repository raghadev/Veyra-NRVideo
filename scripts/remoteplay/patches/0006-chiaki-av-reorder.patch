+/* ---------- Network simulation: 60 fps, frames of 40 source + 8 FEC units ---------- */
+
+#define SIM_SOURCE 40
+#define SIM_FEC 8
+#define SIM_TOTAL (SIM_SOURCE + SIM_FEC)
+#define SIM_FRAME_US 16667
+#define SIM_BURST_US 4000
+#define SIM_BASE_DELAY_US 1000
+
+typedef struct sim_packet_t
+{
+	FakeEntry entry;
+	int64_t arrival;
+	bool lost;
+	int64_t dispatched_at; // -1 = never
+} SimPacket;
+
+typedef struct sim_t
+{
+	SimPacket *packets;
+	size_t count;
+	size_t *order; // by arrival
+	int64_t now;
+	// what the frame processor reports to packet_stats: one generation per frame, when the next one starts
+	ChiakiPacketStats *stats;
+	bool have_frame;
+	uint64_t frame;
+	uint32_t frame_units;
+	uint64_t queue_drops; // good packets the full reorder queue threw away
+} Sim;
+
+typedef struct sim_result_t
+{
+	uint64_t frames;
+	uint64_t frames_rebuildable; // at least SIM_SOURCE units physically arrived
+	uint64_t frames_delivered; // at least SIM_SOURCE units dispatched
+	uint64_t lost_packets;
+	int64_t extra_us_total; // sum over frames of (ready when dispatched - ready when arrived)
+	uint64_t timeout_skips;
+	uint64_t fec_skips;
+	uint64_t too_late_fec; // reordered packets that arrived after FEC already rebuilt their frame
+	uint64_t packets_sent;
+	uint64_t reported_lost; // loss the congestion control would send to the console, over the whole run
+	uint64_t queue_drops;
+} SimResult;
+
+static uint64_t rng_next(uint64_t *s)
+{
+	uint64_t x = *s;
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	*s = x;
+	return x;
+}
+
+static void sim_dispatch(uint64_t seq_num, void *entry, void *user)
+{
+	(void)seq_num;
+	Sim *sim = user;
+	SimPacket *p = (SimPacket *)entry; // entry is the first member
+	p->dispatched_at = sim->now;
+	uint64_t frame = p->entry.id / SIM_TOTAL;
+	if(sim->have_frame && frame != sim->frame)
+	{
+		chiaki_packet_stats_push_generation(sim->stats, sim->frame_units, SIM_TOTAL - sim->frame_units);
+		sim->frame_units = 0;
+	}
+	sim->have_frame = true;
+	sim->frame = frame;
+	sim->frame_units++;
+}
+
+static void sim_drop(uint64_t seq_num, void *elem_user, void *cb_user)
+{
+	(void)seq_num;
+	SimPacket *p = (SimPacket *)elem_user;
+	if(p->dispatched_at < 0)
+		((Sim *)cb_user)->queue_drops++;
+}
+
+// Print the measured numbers when CHIAKI_TEST_REPORT is set (munit hides info logs of passing tests).
+#define REPORT(...) do { if(getenv("CHIAKI_TEST_REPORT")) fprintf(stderr, __VA_ARGS__); } while(0)
+
+static int cmp_i64(const void *a, const void *b)
+{
+	int64_t x = *(const int64_t *)a, y = *(const int64_t *)b;
+	return (x > y) - (x < y);
+}
+
+static Sim *sim_sort_ctx;
+
+static int cmp_arrival(const void *a, const void *b)
+{
+	const SimPacket *x = &sim_sort_ctx->packets[*(const size_t *)a];
+	const SimPacket *y = &sim_sort_ctx->packets[*(const size_t *)b];
+	if(x->arrival != y->arrival)
+		return (x->arrival > y->arrival) - (x->arrival < y->arrival);
+	return (x->entry.id > y->entry.id) - (x->entry.id < y->entry.id);
+}
+
+static void simulate(bool adaptive, uint32_t loss_permille, uint32_t reorder_permille, int64_t reorder_max_us,
+		uint64_t frames, uint64_t seed, SimResult *res)
+{
+	memset(res, 0, sizeof(*res));
+	Sim sim = { 0 };
+	sim.count = (size_t)(frames * SIM_TOTAL);
+	sim.packets = calloc(sim.count, sizeof(SimPacket));
+	sim.order = calloc(sim.count, sizeof(size_t));
+	munit_assert_not_null(sim.packets);
+	munit_assert_not_null(sim.order);
+
+	uint64_t rng = seed;
+	size_t n = 0;
+	for(uint64_t f=0; f<frames; f++)
+	{
+		for(uint16_t u=0; u<SIM_TOTAL; u++)
+		{
+			SimPacket *p = &sim.packets[f * SIM_TOTAL + u];
+			p->entry.id = f * SIM_TOTAL + u;
+			p->entry.unit.packet_index = (ChiakiSeqNum16)p->entry.id;
+			p->entry.unit.frame_index = (ChiakiSeqNum16)(f + 1);
+			p->entry.unit.unit_index = u;
+			p->entry.unit.units_total = SIM_TOTAL;
+			p->entry.unit.units_fec = SIM_FEC;
+			p->arrival = (int64_t)f * SIM_FRAME_US + (int64_t)u * SIM_BURST_US / SIM_TOTAL + SIM_BASE_DELAY_US;
+			if(rng_next(&rng) % 1000 < reorder_permille)
+				p->arrival += (int64_t)(rng_next(&rng) % (uint64_t)(reorder_max_us + 1));
+			p->lost = rng_next(&rng) % 1000 < loss_permille;
+			p->dispatched_at = -1;
+			if(p->lost)
+				res->lost_packets++;
+			else
+				sim.order[n++] = (size_t)p->entry.id;
+		}
+	}
+	sim_sort_ctx = &sim;
+	qsort(sim.order, n, sizeof(size_t), cmp_arrival);
+
+	ChiakiReorderQueue queue;
+	munit_assert_int(chiaki_reorder_queue_init_16(&queue, 6, 0), ==, CHIAKI_ERR_SUCCESS);
+	chiaki_reorder_queue_set_drop_strategy(&queue, CHIAKI_REORDER_QUEUE_DROP_STRATEGY_BEGIN);
+	chiaki_reorder_queue_set_drop_cb(&queue, sim_drop, &sim);
+	ChiakiPacketStats packet_stats;
+	munit_assert_int(chiaki_packet_stats_init(&packet_stats), ==, CHIAKI_ERR_SUCCESS);
+	ChiakiAvReorderStatsBox box;
+	munit_assert_int(chiaki_av_reorder_stats_box_init(&box), ==, CHIAKI_ERR_SUCCESS);
+	box.packet_stats = &packet_stats;
+	sim.stats = &packet_stats;
+	ChiakiAvReorder reorder;
+	chiaki_av_reorder_init(&reorder, adaptive, &box);
+
+	for(size_t i=0; i<n; i++)
+	{
+		SimPacket *p = &sim.packets[sim.order[i]];
+		// the takion thread wakes up for pending timeouts before the next packet
+		for(;;)
+		{
+			int64_t timeout = chiaki_av_reorder_next_timeout_us(&reorder, sim.now);
+			if(timeout < 0 || sim.now + timeout + 1 > p->arrival)
+				break;
+			sim.now += timeout + 1;
+			chiaki_av_reorder_flush(&reorder, &queue, sim.now, unit_of, sim_dispatch, &sim);
+		}
+		sim.now = p->arrival;
+		chiaki_av_reorder_on_arrival(&reorder, &queue, p->entry.unit.packet_index, sim.now);
+		chiaki_reorder_queue_push(&queue, p->entry.unit.packet_index, &p->entry);
+		chiaki_av_reorder_flush(&reorder, &queue, sim.now, unit_of, sim_dispatch, &sim);
+	}
+	sim.now += 1000000;
+	chiaki_av_reorder_flush(&reorder, &queue, sim.now, unit_of, sim_dispatch, &sim);
+
+	res->frames = frames;
+	res->timeout_skips = reorder.stats.timeout_skips;
+	res->fec_skips = reorder.stats.fec_skips;
+	res->too_late_fec = reorder.stats.too_late_fec;
+	res->packets_sent = sim.count;
+	res->queue_drops = sim.queue_drops;
+	if(sim.have_frame)
+		chiaki_packet_stats_push_generation(&packet_stats, sim.frame_units, SIM_TOTAL - sim.frame_units);
+	uint64_t reported_received = 0;
+	chiaki_packet_stats_get(&packet_stats, false, &reported_received, &res->reported_lost);
+	int64_t arrived[SIM_TOTAL], dispatched[SIM_TOTAL];
+	for(uint64_t f=0; f<frames; f++)
+	{
+		size_t na = 0, nd = 0;
+		for(uint16_t u=0; u<SIM_TOTAL; u++)
+		{
+			SimPacket *p = &sim.packets[f * SIM_TOTAL + u];
+			if(!p->lost)
+				arrived[na++] = p->arrival;
+			if(p->dispatched_at >= 0)
+				dispatched[nd++] = p->dispatched_at;
+		}
+		if(na < SIM_SOURCE)
+			continue;
+		res->frames_rebuildable++;
+		if(nd < SIM_SOURCE)
+			continue;
+		res->frames_delivered++;
+		qsort(arrived, na, sizeof(int64_t), cmp_i64);
+		qsort(dispatched, nd, sizeof(int64_t), cmp_i64);
+		int64_t extra = dispatched[SIM_SOURCE - 1] - arrived[SIM_SOURCE - 1];
+		res->extra_us_total += extra > 0 ? extra : 0;
+	}
+
+	chiaki_reorder_queue_fini(&queue);
+	chiaki_av_reorder_stats_box_fini(&box);
+	chiaki_packet_stats_fini(&packet_stats);
+	free(sim.order);
+	free(sim.packets);
+}
+
+// SC-001 and SC-002: 1% random loss, no reordering.
+static MunitResult test_sim_loss(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	SimResult legacy, adaptive;
+	simulate(false, 10, 0, 0, 3600, 0x9e3779b97f4a7c15ull, &legacy);
+	simulate(true, 10, 0, 0, 3600, 0x9e3779b97f4a7c15ull, &adaptive);
+	munit_assert_uint64(legacy.lost_packets, ==, adaptive.lost_packets);
+	munit_assert_uint64(legacy.lost_packets, >, 1000);
+	double legacy_per_loss = (double)legacy.extra_us_total / (double)legacy.lost_packets;
+	double adaptive_per_loss = (double)adaptive.extra_us_total / (double)adaptive.lost_packets;
+	REPORT("loss 1%%: lost=%llu legacy extra/loss=%.0f us adaptive extra/loss=%.0f us "
+			"delivered legacy=%llu adaptive=%llu rebuildable=%llu fec_skips=%llu timeout_skips=%llu\n",
+			(unsigned long long)legacy.lost_packets, legacy_per_loss, adaptive_per_loss,
+			(unsigned long long)legacy.frames_delivered, (unsigned long long)adaptive.frames_delivered,
+			(unsigned long long)adaptive.frames_rebuildable,
+			(unsigned long long)adaptive.fec_skips, (unsigned long long)adaptive.timeout_skips);
+	munit_assert_double(legacy_per_loss, >, 8000.0);
+	munit_assert_double(adaptive_per_loss, <, 1000.0);
+	munit_assert_uint64(adaptive.frames_delivered, >=, legacy.frames_delivered);
+	munit_assert_uint64(adaptive.frames_delivered, ==, adaptive.frames_rebuildable);
+	// The console hears exactly the true loss. The old 16 ms wait could overflow the 64 slot queue and
+	// throw good packets away, which it then reported as lost too.
+	REPORT("loss 1%%: reported to the console legacy=%llu adaptive=%llu (true loss %llu) queue drops legacy=%llu adaptive=%llu\n",
+			(unsigned long long)legacy.reported_lost, (unsigned long long)adaptive.reported_lost,
+			(unsigned long long)adaptive.lost_packets,
+			(unsigned long long)legacy.queue_drops, (unsigned long long)adaptive.queue_drops);
+	munit_assert_uint64(adaptive.reported_lost, ==, adaptive.lost_packets);
+	munit_assert_uint64(adaptive.reported_lost, <=, legacy.reported_lost);
+	munit_assert_uint64(adaptive.queue_drops, ==, 0);
+	return MUNIT_OK;
+}
+
+// SC-003: reordering up to 3 ms, no loss: every frame whole, no timeout skip.
+static MunitResult test_sim_reorder(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	SimResult res, legacy;
+	simulate(true, 0, 50, 3000, 3600, 0x2545f4914f6cdd1dull, &res);
+	simulate(false, 0, 50, 3000, 3600, 0x2545f4914f6cdd1dull, &legacy);
+	REPORT("reorder 5%% up to 3 ms: delivered=%llu of %llu fec_skips=%llu timeout_skips=%llu "
+			"extra/frame=%.0f us late-after-fec=%llu (%.2f%% of packets, credited back as received)\n",
+			(unsigned long long)res.frames_delivered, (unsigned long long)res.frames,
+			(unsigned long long)res.fec_skips, (unsigned long long)res.timeout_skips,
+			(double)res.extra_us_total / (double)res.frames,
+			(unsigned long long)res.too_late_fec, 100.0 * (double)res.too_late_fec / (double)res.packets_sent);
+	munit_assert_uint64(res.frames_delivered, ==, res.frames);
+	munit_assert_uint64(res.timeout_skips, ==, 0);
+	// SC-008: reordering within 16 ms, the console hears the same loss as with the old policy
+	REPORT("reorder 5%% up to 3 ms: reported to the console legacy=%llu adaptive=%llu\n",
+			(unsigned long long)legacy.reported_lost, (unsigned long long)res.reported_lost);
+	munit_assert_uint64(res.reported_lost, ==, legacy.reported_lost);
+	return MUNIT_OK;
+}
+
+MunitTest tests_av_reorder[] = {
+	{ "/fec_skip_now", test_fec_skip_now, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/legacy_waits_16ms", test_legacy_waits_16ms, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/fec_unit_of_complete_frame", test_fec_unit_of_complete_frame, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/gap_after_frame_end_is_next_frame", test_gap_after_frame_end_is_next_frame, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/unrecoverable_waits_window", test_unrecoverable_waits_window, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/late_fill", test_late_fill, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/window_decays", test_window_decays, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/too_late_raises_window", test_too_late_raises_window, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/legacy_window_fixed", test_legacy_window_fixed, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/wraparound", test_wraparound, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/late_fec_packet_not_reported_lost", test_late_fec_packet_not_reported_lost, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/packet_stats_late_credit", test_packet_stats_late_credit, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/stats_box", test_stats_box, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/sim_loss", test_sim_loss, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/sim_reorder", test_sim_reorder, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
+};
