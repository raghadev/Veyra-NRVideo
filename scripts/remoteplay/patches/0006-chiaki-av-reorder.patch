+// A packet that shows up after its gap was skipped on timeout raises the window at once.
+// One skipped through FEC cost nothing and must not raise it.
+static MunitResult test_too_late_raises_window(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	Harness h;
+	harness_init(&h, true, 100);
+	idle_until(&h, 0, 10000000, 10000);
+	munit_assert_uint32(h.reorder.window_us, ==, CHIAKI_AV_REORDER_WINDOW_MIN_US);
+
+	const int64_t t0 = 10000000;
+	// FEC-skipped gap, its packet comes later: no change.
+	arrive(&h, t0, 7, 100, 0, 6, 2);
+	arrive(&h, t0 + 100, 7, 100, 2, 6, 2);
+	arrive(&h, t0 + 200, 7, 100, 3, 6, 2);
+	arrive(&h, t0 + 300, 7, 100, 4, 6, 2); // 1 + 3 = 4: seq 101 skipped through FEC
+	munit_assert_uint64(h.reorder.stats.fec_skips, ==, 1);
+	arrive(&h, t0 + 400, 7, 100, 5, 6, 2);
+	arrive(&h, t0 + 900, 7, 100, 1, 6, 2); // the skipped one, too late
+	munit_assert_uint64(h.reorder.stats.too_late_fec, ==, 1);
+	munit_assert_uint32(h.reorder.window_us, ==, CHIAKI_AV_REORDER_WINDOW_MIN_US);
+
+	// Unrecoverable frame 8 (no FEC), seq 107 missing, noticed at t1, skipped on timeout.
+	const int64_t t1 = t0 + 20000;
+	arrive(&h, t1 - 100, 8, 106, 0, 4, 0);
+	arrive(&h, t1, 8, 106, 2, 4, 0);
+	flush_at(&h, t1 + CHIAKI_AV_REORDER_WINDOW_MIN_US + 1);
+	munit_assert_uint64(h.reorder.stats.timeout_skips, ==, 1);
+	// It arrives 5 ms after the gap was noticed: window = 5000 * 3 / 2 + 1000 = 8500.
+	arrive(&h, t1 + 5000, 8, 106, 1, 4, 0);
+	munit_assert_uint64(h.reorder.stats.too_late_timeout, ==, 1);
+	munit_assert_uint32(h.reorder.window_us, ==, 8500);
+	harness_fini(&h);
+	return MUNIT_OK;
+}
