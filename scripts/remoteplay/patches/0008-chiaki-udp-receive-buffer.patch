+/**
+ * Give the takion socket a receive buffer large enough for a whole large video frame.
+ *
+ * A single frame (an IDR at a high bitrate) is several hundred kB sent in one burst. The buffer used to
+ * be the advertised data window (100 kB), so the kernel dropped whatever the takion thread had not read
+ * yet. Tries CHIAKI_TAKION_SOCKET_RCVBUF bytes, then halves it while the system refuses.
+ *
+ * @param minimum size to fall back to (never set less than this)
+ * @return the size that was set, or a negative value if not even minimum could be set
+ */
+CHIAKI_EXPORT int chiaki_takion_socket_set_rcvbuf(chiaki_socket_t sock, int minimum);
+
 /**
  * Must be called from within the Takion thread, i.e. inside the callback!
  */
