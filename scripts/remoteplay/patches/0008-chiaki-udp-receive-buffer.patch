diff --git a/test/takionsocket.c b/test/takionsocket.c
new file mode 100644
index 0000000..700e3d3
--- /dev/null
+++ b/test/takionsocket.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include <munit.h>
+
+#include <chiaki/takion.h>
+
+#include "test_log.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef _WIN32
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <poll.h>
+#include <unistd.h>
+
+#define REPORT(...) do { if(getenv("CHIAKI_TEST_REPORT")) fprintf(stderr, __VA_ARGS__); } while(0)
+
+// One large video frame: an IDR at a high bitrate is several hundred kB sent in one burst.
+#define BURST_PACKETS 300
+#define BURST_PACKET_SIZE 1400
+#define OLD_RCVBUF 0x19000 // what takion used before: the advertised data window, 100 kB
+
+static int open_receiver(struct sockaddr_in *addr)
+{
+	int sock = socket(AF_INET, SOCK_DGRAM, 0);
+	munit_assert_int(sock, >=, 0);
+	memset(addr, 0, sizeof(*addr));
+	addr->sin_family = AF_INET;
+	addr->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+	munit_assert_int(bind(sock, (struct sockaddr *)addr, sizeof(*addr)), ==, 0);
+	socklen_t len = sizeof(*addr);
+	munit_assert_int(getsockname(sock, (struct sockaddr *)addr, &len), ==, 0);
+	return sock;
+}
+
+/**
+ * Send the burst while nobody reads (the takion thread is busy or descheduled for a few ms),
+ * then count what the kernel kept for the receiver.
+ */
+static int burst_and_count(int receiver, const struct sockaddr_in *addr)
+{
+	int sender = socket(AF_INET, SOCK_DGRAM, 0);
+	munit_assert_int(sender, >=, 0);
+	uint8_t packet[BURST_PACKET_SIZE];
+	memset(packet, 0x5a, sizeof(packet));
+	for(int i = 0; i < BURST_PACKETS; i++)
+	{
+		ssize_t sent = sendto(sender, packet, sizeof(packet), 0, (const struct sockaddr *)addr, sizeof(*addr));
+		munit_assert_int64((int64_t)sent, ==, (int64_t)sizeof(packet));
+		if(i % 50 == 49)
+			usleep(1000); // keep the loopback interface queue shallow; the receiver still does not read
+	}
+	close(sender);
+	int got = 0;
+	for(;;)
+	{
+		struct pollfd pfd = { .fd = receiver, .events = POLLIN };
+		if(poll(&pfd, 1, 200) <= 0)
+			break;
+		if(recv(receiver, packet, sizeof(packet), 0) <= 0)
+			break;
+		got++;
+	}
+	return got;
+}
+
+// With the old 100 kB buffer the kernel throws away most of a large frame that arrives while the
+// takion thread is not reading; the larger buffer keeps all of it.
+static MunitResult test_socket_rcvbuf_holds_frame_burst(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	struct sockaddr_in addr;
+
+	int small = open_receiver(&addr);
+	int old_size = OLD_RCVBUF;
+	munit_assert_int(setsockopt(small, SOL_SOCKET, SO_RCVBUF, &old_size, sizeof(old_size)), ==, 0);
+	int got_small = burst_and_count(small, &addr);
+	close(small);
+
+	int big = open_receiver(&addr);
+	int set = chiaki_takion_socket_set_rcvbuf(big, OLD_RCVBUF);
+	munit_assert_int(set, >=, 1024 * 1024);
+	int effective = 0;
+	socklen_t len = sizeof(effective);
+	munit_assert_int(getsockopt(big, SOL_SOCKET, SO_RCVBUF, &effective, &len), ==, 0);
+	if(effective < 2 * BURST_PACKETS * BURST_PACKET_SIZE)
+	{
+		close(big);
+		return MUNIT_SKIP; // this host silently caps socket buffers (Linux rmem_max)
+	}
+	int got_big = burst_and_count(big, &addr);
+	close(big);
+
+	REPORT("rcvbuf: burst of %d packets (%d kB) while nobody reads: old 100 kB buffer kept %d, new %d kB buffer kept %d\n",
+			BURST_PACKETS, BURST_PACKETS * BURST_PACKET_SIZE / 1000, got_small, effective / 1024, got_big);
+	munit_assert_int(got_small, <, BURST_PACKETS);
+	munit_assert_int(got_big, ==, BURST_PACKETS);
+	return MUNIT_OK;
+}
+
+// Never go below the size the caller could already rely on.
+static MunitResult test_socket_rcvbuf_minimum(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	struct sockaddr_in addr;
+	int sock = open_receiver(&addr);
+	munit_assert_int(chiaki_takion_socket_set_rcvbuf(sock, OLD_RCVBUF), >=, OLD_RCVBUF);
+	close(sock);
+	munit_assert_int(chiaki_takion_socket_set_rcvbuf(-1, OLD_RCVBUF), <, 0); // not a socket
+	return MUNIT_OK;
+}
+
+static void ignore_event(ChiakiTakionEvent *event, void *user)
+{
+	(void)event; (void)user;
+}
+
+// The real takion socket gets the large buffer, not only the helper.
+static MunitResult test_connect_uses_large_rcvbuf(const MunitParameter params[], void *user)
+{
+	(void)params; (void)user;
+	struct sockaddr_in addr;
+	int probe = open_receiver(&addr);
+	munit_assert_int(chiaki_takion_socket_set_rcvbuf(probe, OLD_RCVBUF), >=, OLD_RCVBUF);
+	int expected = 0;
+	socklen_t len = sizeof(expected);
+	munit_assert_int(getsockopt(probe, SOL_SOCKET, SO_RCVBUF, &expected, &len), ==, 0);
+	if(expected <= 2 * OLD_RCVBUF)
+	{
+		close(probe);
+		return MUNIT_SKIP; // this host caps socket buffers, nothing to tell apart
+	}
+
+	// "probe" stays bound and silent: the handshake of the takion below never gets an answer
+	ChiakiTakion takion;
+	memset(&takion, 0, sizeof(takion));
+	ChiakiTakionConnectInfo info;
+	memset(&info, 0, sizeof(info));
+	info.log = get_test_log();
+	info.sa = (struct sockaddr *)&addr;
+	info.sa_len = sizeof(addr);
+	info.cb = ignore_event;
+	info.protocol_version = 12;
+	info.close_socket = true;
+	munit_assert_int(chiaki_takion_connect(&takion, &info, NULL), ==, CHIAKI_ERR_SUCCESS);
+	int effective = 0;
+	len = sizeof(effective);
+	int r = getsockopt(takion.sock, SOL_SOCKET, SO_RCVBUF, &effective, &len);
+	chiaki_takion_close(&takion);
+	close(probe);
+	munit_assert_int(r, ==, 0);
+	munit_assert_int(effective, ==, expected);
+	return MUNIT_OK;
+}
+
+MunitTest tests_takion_socket[] = {
+	{ "/connect_uses_large_rcvbuf", test_connect_uses_large_rcvbuf, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/rcvbuf_holds_frame_burst", test_socket_rcvbuf_holds_frame_burst, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/rcvbuf_minimum", test_socket_rcvbuf_minimum, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
+};
+
+#else
+
+MunitTest tests_takion_socket[] = {
+	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
+};
+
+#endif
