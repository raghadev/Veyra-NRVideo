@@ -189,6 +189,19 @@ static ChiakiErrorCode takion_recv_message_cookie_ack(ChiakiTakion *takion);
 static void takion_handle_packet_av(ChiakiTakion *takion, uint8_t base_type, uint8_t *buf, size_t buf_size);
 static ChiakiErrorCode takion_read_extra_sock_messages(ChiakiTakion *takion);
 
+CHIAKI_EXPORT int chiaki_takion_socket_set_rcvbuf(chiaki_socket_t sock, int minimum)
+{
+	// Some systems refuse a size above their limit instead of clamping it: halve until one is accepted.
+	for(int size = CHIAKI_TAKION_SOCKET_RCVBUF; size > minimum; size /= 2)
+	{
+		if(setsockopt(sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&size, sizeof(size)) == 0)
+			return size;
+	}
+	if(setsockopt(sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&minimum, sizeof(minimum)) == 0)
+		return minimum;
+	return -1;
+}
